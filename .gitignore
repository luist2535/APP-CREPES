# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite WAL and temp files
*.db
*.db-wal
*.db-shm
*.db-journal

# user uploads folder
/public/uploads/*
!/public/uploads/.gitkeep

# executables
cloudflared.exe
startup_log.txt

# Base de datos local y temporales
*.sqlite
*.sqlite3
database.sqlite
database.sqlite-shm
database.sqlite-wal

# Scripts de prueba y utilidades locales
fix_*.js
query_db.js
read_excel*.js
repair.js

# Carpetas y archivos de uso estrictamente local (no subir a GitHub)
/public/archivos/excel/
/public/archivos/documentos/
/FORMATO DE ENTREGA DE EQUIPO/
